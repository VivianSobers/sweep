#!/usr/bin/env bash
set -euo pipefail

script_path=$0
while [ -L "$script_path" ]; do
  script_dir=$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd -P)
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path="$script_dir/$link_target" ;;
  esac
done
script_dir=$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd -P)
repo_dir=$(cd -P "$script_dir/.." >/dev/null 2>&1 && pwd -P)

. "$repo_dir/lib/safety.sh"
. "$repo_dir/lib/size.sh"
. "$repo_dir/lib/registry.sh"
. "$repo_dir/lib/report.sh"

sweep_require_user || exit 1

sweep_usage() {
  cat <<'USAGE'
Usage: sweep [--help|--version|list|clean]

  sweep                 Show cache sizes without deleting anything
  sweep list            List cache categories and paths
  sweep clean           Clean selected cache categories
  sweep --help          Show this help
  sweep --version       Show the version
USAGE
}

if [ "$#" -eq 0 ]; then
  sweep_report
  exit $?
fi

case "$1" in
  -h|--help)
    if [ "$#" -ne 1 ]; then
      printf '%s\n' 'sweep: help takes no arguments' >&2
      exit 2
    fi
    sweep_usage
    exit 0
    ;;
  --version)
    if [ "$#" -ne 1 ]; then
      printf '%s\n' 'sweep: --version takes no arguments' >&2
      exit 2
    fi
    printf '%s\n' 'sweep 0.1.0'
    exit 0
    ;;
  list)
    if [ "$#" -ne 1 ]; then
      printf '%s\n' 'sweep: list takes no arguments' >&2
      exit 2
    fi
    while IFS= read -r category_id; do
      category_label=$(sweep_category_field "$category_id" label) || continue
      category_paths=$(sweep_category_field "$category_id" paths) || continue
      [ -n "$category_paths" ] || continue
      while IFS= read -r category_path; do
        [ -n "$category_path" ] || continue
        printf '%s\t%s\t%s\n' "$category_id" "$category_label" "$category_path"
      done <<EOF
$category_paths
EOF
    done <<EOF
$(sweep_category_ids)
EOF
    exit 0
    ;;
  clean)
    printf '%s\n' 'sweep: clean is not available yet' >&2
    exit 2
    ;;
  *)
    printf 'sweep: unknown command: %s\n' "$1" >&2
    exit 2
    ;;
esac
